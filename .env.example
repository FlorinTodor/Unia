# Proveedor activo: groq | cerebras | ollama
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — también se usa para Whisper (voz)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras (https://cloud.cerebras.ai) — proveedor alternativo
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Ollama local — fallback sin internet
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b   (ya instalado; qwen3:8b da mejor calidad si cabe en tu GPU)
