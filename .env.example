# Proveedor activo: groq | cerebras | ollama
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — también se usa para Whisper (voz)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras (https://cloud.cerebras.ai) — proveedor alternativo
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Ollama local — fallback sin internet
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b   (ya instalado; qwen3:8b da mejor calidad si cabe en tu GPU)

# --- Límites de uso de la IA (opcionales; valores por defecto entre paréntesis) ---
# TOKENS_DIA_CLIENTE=80000       # tokens por cliente y día (se renueva a medianoche)
# TOKENS_MAX_TURNO=30000         # tope de una sola pregunta con todas sus rondas de herramientas
# MAX_CARACTERES_MENSAJE=1500    # mensaje más largo -> 413
# PETICIONES_POR_MINUTO=20       # por cliente -> 429 con Retry-After
# MAX_TOKENS_RESPUESTA=4096      # tope de salida por llamada al modelo
# MAX_TOKENS_HISTORIAL=3000      # lo que se reenvía de la conversación anterior
# MAX_CARACTERES_RESULTADO=6000  # tamaño máximo de un resultado SQL que se devuelve al modelo

# --- Otros ---
# DOCS_API=1                     # publica Swagger (/docs), ReDoc y /openapi.json (apagado por defecto)
# COOKIE_SEGURA=1                # marca la cookie de sesión como Secure (activar al servir por HTTPS)

