# Proveedor activo: groq | cerebras | ollama
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — también se usa para Whisper (voz)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras (https://cloud.cerebras.ai) — proveedor alternativo
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Ollama local — fallback sin internet
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b   (ya instalado; qwen3:8b da mejor calidad si cabe en tu GPU)

# --- Límites de uso de la IA (opcionales; valores por defecto entre paréntesis) ---
# TOKENS_DIA_CLIENTE=80000       # tokens por cliente y día (se renueva a medianoche)
# TOKENS_DIA_LOCAL=400000       # tope diario del modelo local (Ollama), aparte del de la nube
# TOKENS_MAX_TURNO=30000         # tope de una sola pregunta con todas sus rondas de herramientas
# MAX_CARACTERES_MENSAJE=1500    # mensaje más largo -> 413
# PETICIONES_POR_MINUTO=20       # por cliente -> 429 con Retry-After
# MAX_TOKENS_RESPUESTA=4096      # tope de salida por llamada al modelo
# MAX_TOKENS_HISTORIAL=3000      # lo que se reenvía de la conversación anterior
# MAX_CARACTERES_RESULTADO=6000  # tamaño máximo de un resultado SQL que se devuelve al modelo

# --- Otros ---
# DOCS_API=1                     # publica Swagger (/docs), ReDoc y /openapi.json (apagado por defecto)
# PROXY_DE_CONFIANZA=1           # solo detrás de un proxy propio que sobrescriba X-Forwarded-For (y arrancando uvicorn con --proxy-headers --forwarded-allow-ips=<ip>); sin definir, esas cabeceras se ignoran
# COOKIE_SEGURA=1                # fuerza Secure (1) o no (0) en la cookie de sesión; sin definir, se pone solo si la petición llega por HTTPS
# OLLAMA_HOSTS_PERMITIDOS=       # hosts extra (separados por comas) donde se admite Ollama; por defecto solo localhost/127.0.0.1/::1


# Contraseñas con las que se siembra la base de datos de demo (solo se guarda su hash).
# Si no las defines, es el usuario seguido de 2026. Cámbialas al desplegar.
# El administrador NO tiene valor por defecto: sin CONTRASENA_ADMIN el perfil `admin` no existe.
# CONTRASENA_ALEX=
# CONTRASENA_ADMIN=

# Voz del servidor (POST /tts). auto = OmniVoice (requirements-voz.txt + GPU + data/voces/unia_ref.wav) con Piper de reserva
# TTS_MOTOR=auto            # auto | piper
# TTS_VELOCIDAD=1.0         # OmniVoice: < 1 más pausada (con 0.95 metía más cortes a mitad de frase)
# TTS_PASOS=16              # OmniVoice: 32 = algo mejor y el doble de lento
# TTS_LENGTH_SCALE=0.78     # Piper: mayor = más lento
